    },
    "./authority": {
      "types": "./src/core/authority/index.ts",
      "default": "./src/core/authority/index.ts"
    },
    "./ctx": {
      "types": "./src/core/context/index.ts",
      "default": "./src/core/context/index.ts"
    },
    "./context": {
      "types": "./src/core/context/index.ts",
      "default": "./src/core/context/index.ts"
    },
    "./error": {
      "types": "./src/core/errors/index.ts",
      "default": "./src/core/errors/index.ts"
    },
    "./errors": {
      "types": "./src/core/errors/index.ts",
      "default": "./src/core/errors/index.ts"
    },
    "./fn": {
      "types": "./src/core/fn/index.ts",
      "default": "./src/core/fn/index.ts"
    },
    "./logger": {
      "types": "./src/core/logger/index.ts",
      "default": "./src/core/logger/index.ts"
    },
