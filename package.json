    "@types/node": "^22.13.0",
    "agents": "0.30.1",
    "esbuild": "0.28.2",
    "fast-check": "^3.23.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12",
    "zod": "3.25.76"
  }
