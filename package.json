  "scripts": {
    "typecheck": "tsc --noEmit && bun run typecheck:consumers",
    "typecheck:consumers": "bun check -p test/consumers/pure && bun check -p test/consumers/worker && bun check -p test/consumers/testing && bun check -p test/consumers/testing-do && bun check -p test/consumers/cli && bun run typecheck:docs",
    "typecheck:docs": "bun test/consumers/docs/extract.ts && bun check -p test/consumers/docs",
    "test": "vitest run",
    "lint": "tsc --noEmit && ast-grep scan && ast-grep test --skip-snapshot-tests"
  },
  "dependencies": {
    "effect": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "agents": "0.30.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-telemetry": {
      "optional": true
    },
    "agents": {
